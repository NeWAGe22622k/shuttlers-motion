{
  "name": "shuttlers-pod-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "audio": "python3 audio/build_audio.py",
    "render:hero": "remotion render PodHero-16x9 out/pod-hero-16x9.mp4 --codec=h264 --crf=16 --audio-codec=aac",
    "render:cutdown": "remotion render PodCutdown-16x9 out/pod-cutdown-16x9.mp4 --codec=h264 --crf=16 --audio-codec=aac"
  },
  "dependencies": {
    "remotion": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
